# Connection string Neon Postgres
DATABASE_URL=

# Hash bcrypt password login, disimpan dalam format base64 agar karakter $ tidak rusak di .env
AUTH_PASSWORD_HASH=

# String acak panjang (minimal 32 karakter) untuk menandatangani cookie sesi
AUTH_SECRET=

# Zona waktu aplikasi (tanggal log lokal)
APP_TIMEZONE=Asia/Jakarta
